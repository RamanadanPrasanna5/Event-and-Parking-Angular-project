{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Launch EventPark Full Stack (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "🚀 Start Full Stack (Backend + Frontend)",
      "userDataDir": "${workspaceFolder}/.vscode/vscode-chrome-debug-profile",
      "runtimeArgs": [
        "--remote-debugging-port=0"
      ],
      "cleanUp": "wholeBrowser",
      "skipFiles": [
        "chrome://**",
        "chrome-extension://**",
        "<node_internals>/**"
      ]
    },
    {
      "name": "🌐 Launch EventPark Full Stack (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "🚀 Start Full Stack (Backend + Frontend)",
      "userDataDir": "${workspaceFolder}/.vscode/vscode-edge-debug-profile",
      "runtimeArgs": [
        "--remote-debugging-port=0"
      ],
      "cleanUp": "wholeBrowser",
      "skipFiles": [
        "edge://**",
        "chrome-extension://**",
        "<node_internals>/**"
      ]
    },
    {
      "name": "🔐 Open Login Page (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200/login",
      "webRoot": "${workspaceFolder}",
      "userDataDir": "${workspaceFolder}/.vscode/vscode-chrome-debug-profile",
      "runtimeArgs": [
        "--remote-debugging-port=0"
      ],
      "cleanUp": "wholeBrowser",
      "skipFiles": [
        "chrome://**",
        "chrome-extension://**",
        "<node_internals>/**"
      ]
    },
    {
      "name": "🎫 Open Events Catalogue (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200/events",
      "webRoot": "${workspaceFolder}",
      "userDataDir": "${workspaceFolder}/.vscode/vscode-chrome-debug-profile",
      "runtimeArgs": [
        "--remote-debugging-port=0"
      ],
      "cleanUp": "wholeBrowser",
      "skipFiles": [
        "chrome://**",
        "chrome-extension://**",
        "<node_internals>/**"
      ]
    },
    {
      "name": "🛡️ Open Admin Dashboard (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200/admin/dashboard",
      "webRoot": "${workspaceFolder}",
      "userDataDir": "${workspaceFolder}/.vscode/vscode-chrome-debug-profile",
      "runtimeArgs": [
        "--remote-debugging-port=0"
      ],
      "cleanUp": "wholeBrowser",
      "skipFiles": [
        "chrome://**",
        "chrome-extension://**",
        "<node_internals>/**"
      ]
    }
  ]
}